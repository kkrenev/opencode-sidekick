{
  "name": "opencode-sidekick",
  "displayName": "OpenCode Sidekick",
  "description": "The OpenCode agent docked in the VS Code secondary sidebar, next to your code instead of on top of it.",
  "version": "1.2.0",
  "publisher": "kkrenev",
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "opencode",
    "ai",
    "agent",
    "coding agent",
    "sidebar",
    "chat",
    "assistant"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kkrenev/opencode-sidekick"
  },
  "bugs": {
    "url": "https://github.com/kkrenev/opencode-sidekick/issues"
  },
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onView:opencode.sidekick",
    "onWebviewPanel:opencode.sidekick.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencodeSidekickContainer",
          "title": "OpenCode",
          "icon": "resources/opencode.svg"
        }
      ]
    },
    "views": {
      "opencodeSidekickContainer": [
        {
          "id": "opencode.sidekick",
          "type": "webview",
          "name": "OpenCode",
          "icon": "resources/opencode.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.sidekick.focus",
        "title": "Focus OpenCode Sidekick",
        "category": "OpenCode"
      },
      {
        "command": "opencode.sidekick.openChatInEditor",
        "title": "Open Chat in Editor Tab",
        "category": "OpenCode",
        "icon": "$(link-external)"
      },
      {
        "command": "opencode.sidekick.newSession",
        "title": "New Session",
        "category": "OpenCode",
        "icon": "$(add)"
      },
      {
        "command": "opencode.sidekick.history",
        "title": "Show Session History",
        "category": "OpenCode",
        "icon": "$(history)"
      },
      {
        "command": "opencode.sidekick.settings",
        "title": "Open Sidekick Settings",
        "category": "OpenCode",
        "icon": "$(gear)"
      },
      {
        "command": "opencode.sidekick.reload",
        "title": "Reload OpenCode Sidekick",
        "category": "OpenCode",
        "icon": "$(refresh)"
      },
      {
        "command": "opencode.sidekick.openInBrowser",
        "title": "Open OpenCode UI in Browser",
        "category": "OpenCode",
        "icon": "$(link-external)"
      },
      {
        "command": "opencode.sidekick.openTerminal",
        "title": "Open OpenCode in Integrated Terminal",
        "category": "OpenCode",
        "icon": "$(terminal)"
      },
      {
        "command": "opencode.sidekick.attachScreenshot",
        "title": "Attach Screenshot",
        "category": "OpenCode"
      },
      {
        "command": "opencode.sidekick.attachSelection",
        "title": "Add Selection to Chat",
        "category": "OpenCode"
      },
      {
        "command": "opencode.sidekick.addFileToChat",
        "title": "Add File to Chat",
        "category": "OpenCode"
      },
      {
        "command": "opencode.sidekick.addProblemsToChat",
        "title": "Add Problems to Chat",
        "category": "OpenCode"
      },
      {
        "command": "opencode.sidekick.copyLastAnswer",
        "title": "Copy Last Answer",
        "category": "OpenCode"
      },
      {
        "command": "opencode.sidekick.copyTranscript",
        "title": "Copy Conversation as Markdown",
        "category": "OpenCode"
      },
      {
        "command": "opencode.sidekick.copySelection",
        "title": "Copy Selection with Reference",
        "category": "OpenCode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencode.sidekick.newSession",
          "when": "view == opencode.sidekick",
          "group": "navigation@1"
        },
        {
          "command": "opencode.sidekick.reload",
          "when": "view == opencode.sidekick",
          "group": "navigation@2"
        },
        {
          "command": "opencode.sidekick.openInBrowser",
          "when": "view == opencode.sidekick",
          "group": "navigation@3"
        },
        {
          "command": "opencode.sidekick.settings",
          "when": "view == opencode.sidekick",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "opencode.sidekick.addFileToChat",
          "group": "opencode@1"
        },
        {
          "command": "opencode.sidekick.attachSelection",
          "when": "editorHasSelection",
          "group": "opencode@2"
        },
        {
          "command": "opencode.sidekick.addProblemsToChat",
          "group": "opencode@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "opencode.sidekick.addFileToChat",
          "group": "opencode@1"
        },
        {
          "command": "opencode.sidekick.attachSelection",
          "group": "opencode@2"
        },
        {
          "command": "opencode.sidekick.addProblemsToChat",
          "group": "opencode@3"
        }
      ],
      "commandPalette": [
        {
          "command": "opencode.sidekick.focus"
        },
        {
          "command": "opencode.sidekick.openChatInEditor"
        },
        {
          "command": "opencode.sidekick.newSession"
        },
        {
          "command": "opencode.sidekick.history"
        },
        {
          "command": "opencode.sidekick.settings"
        },
        {
          "command": "opencode.sidekick.reload"
        },
        {
          "command": "opencode.sidekick.openInBrowser"
        },
        {
          "command": "opencode.sidekick.openTerminal"
        },
        {
          "command": "opencode.sidekick.attachScreenshot"
        },
        {
          "command": "opencode.sidekick.attachSelection"
        },
        {
          "command": "opencode.sidekick.addFileToChat"
        },
        {
          "command": "opencode.sidekick.addProblemsToChat"
        },
        {
          "command": "opencode.sidekick.copyLastAnswer"
        },
        {
          "command": "opencode.sidekick.copyTranscript"
        },
        {
          "command": "opencode.sidekick.copySelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.sidekick.focus",
        "key": "ctrl+alt+shift+o",
        "mac": "cmd+alt+shift+o"
      },
      {
        "command": "opencode.sidekick.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "configuration": {
      "title": "OpenCode Sidekick",
      "properties": {
        "opencodeSidekick.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Default model for new sessions, in `provider/model` form. Empty uses the server default."
        },
        "opencodeSidekick.defaultEffort": {
          "type": "string",
          "default": "",
          "description": "Default reasoning effort (model variant) for new sessions. Empty lets the model decide."
        },
        "opencodeSidekick.defaultMode": {
          "type": "string",
          "default": "",
          "description": "Default agent mode for new sessions. Empty uses the server default (usually Build)."
        },
        "opencodeSidekick.sendKey": {
          "type": "string",
          "enum": [
            "enter",
            "mod-enter"
          ],
          "enumDescriptions": [
            "Enter sends, Shift+Enter adds a new line.",
            "Cmd/Ctrl+Enter sends, Enter adds a new line."
          ],
          "default": "enter",
          "description": "Keyboard shortcut for sending a message."
        },
        "opencodeSidekick.autoScroll": {
          "type": "boolean",
          "default": true,
          "description": "Keep the transcript scrolled to the newest output while the agent streams."
        },
        "opencodeSidekick.showTimestamps": {
          "type": "boolean",
          "default": false,
          "description": "Show the time next to assistant messages."
        },
        "opencodeSidekick.reasoning": {
          "type": "string",
          "enum": [
            "collapsed",
            "expanded",
            "hidden"
          ],
          "enumDescriptions": [
            "Show reasoning as a collapsed block.",
            "Show reasoning expanded by default.",
            "Hide reasoning blocks completely."
          ],
          "default": "collapsed",
          "description": "How to display model reasoning."
        },
        "opencodeSidekick.compactTools": {
          "type": "boolean",
          "default": true,
          "description": "Collapse tool input and output details by default."
        },
        "opencodeSidekick.accent": {
          "type": "string",
          "enum": [
            "mint",
            "blue",
            "violet",
            "amber"
          ],
          "default": "mint",
          "description": "Accent color used by the panel."
        },
        "opencodeSidekick.density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ],
          "default": "comfortable",
          "description": "Spacing density of the panel."
        },
        "opencodeSidekick.fontSize": {
          "type": "string",
          "enum": [
            "small",
            "default",
            "large"
          ],
          "default": "default",
          "description": "Base font size of the panel."
        },
        "opencodeSidekick.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the opencode executable. Leave empty to use the first `opencode` found on PATH."
        },
        "opencodeSidekick.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Start the OpenCode background server automatically when the sidebar opens and no server is running."
        },
        "opencodeSidekick.contextWarnPercent": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "Context usage percentage that shows the Compact warning in the composer."
        },
        "opencodeSidekick.contextCompactPercent": {
          "type": "number",
          "default": 95,
          "minimum": 1,
          "maximum": 100,
          "description": "Context usage percentage that triggers an automatic compaction of the active session."
        },
        "opencodeSidekick.permissionsAutoApproveSafe": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Answer read-only tool requests (`read`, `glob`, `grep`, `list`, `find`) without showing a permission card. Shell commands, file edits, network access and external directories always ask."
        },
        "opencodeSidekick.queueDelivery": {
          "type": "string",
          "enum": [
            "queue",
            "steer"
          ],
          "enumDescriptions": [
            "Wait in the queue and run in order after the current turn.",
            "Join the running turn at its next step boundary."
          ],
          "default": "queue",
          "description": "What happens to a message you send while the agent is working."
        },
        "opencodeSidekick.autoAttachActiveFile": {
          "type": "boolean",
          "default": false,
          "description": "Keep the active workspace file attached to the composer as an automatic chip. Remove the chip to dismiss it until you switch files."
        },
        "opencodeSidekick.notifications": {
          "type": "string",
          "enum": [
            "all",
            "errors",
            "off"
          ],
          "enumDescriptions": [
            "Notify when a turn finishes or a permission request waits for an answer.",
            "Notify only when a turn fails.",
            "Never show system notifications. The tab badge and the connection banner stay."
          ],
          "default": "all",
          "description": "Which finished turns raise a system notification."
        },
        "opencodeSidekick.notifyOnlyWhenHidden": {
          "type": "boolean",
          "default": true,
          "description": "Notify only when the chat that needs you is not on screen. Turn off to notify for every finished turn, even while you watch it."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "npm run build:chat && npm run build:diff",
    "build:chat": "esbuild src/webview/index.tsx --bundle --outfile=media/main.js --format=iife --target=es2022 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --minify --log-level=warning",
    "build:diff": "esbuild src/webview/diff.tsx --bundle --outfile=media/diff.js --format=iife --target=es2022 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --minify --log-level=warning",
    "watch:webview": "esbuild src/webview/index.tsx --bundle --outfile=media/main.js --format=iife --target=es2022 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --watch --log-level=warning",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:folders": "node scripts/check-workspace-folders.mjs",
    "check:usage": "node scripts/check-context-usage.mjs",
    "check:turn-diff": "node scripts/check-turn-diff.mjs",
    "check:open-target": "node scripts/check-open-target.mjs",
    "check:tool-card": "node scripts/check-tool-card.mjs",
    "check:message-map": "node scripts/check-message-map.mjs",
    "check:revert-api": "node scripts/check-revert-api.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:inbox-api": "node scripts/check-inbox-api.mjs",
    "check:editor-context": "node scripts/check-editor-context.mjs",
    "check:auto-context": "node scripts/check-auto-context.mjs",
    "check:chat-surfaces": "node scripts/check-chat-surfaces.mjs",
    "check:chat-panel": "node scripts/check-chat-panel.mjs",
    "check:chat-search": "node scripts/check-chat-search.mjs",
    "check:notifications": "node scripts/check-notifications.mjs",
    "compile": "npm run check:architecture && tsc -p . && npm run check:folders && npm run check:usage && npm run check:turn-diff && npm run check:open-target && npm run check:tool-card && npm run check:message-map && npm run check:revert-api && npm run check:permissions && npm run check:inbox-api && npm run check:editor-context && npm run check:auto-context && npm run check:chat-surfaces && npm run check:chat-panel && npm run check:chat-search && npm run check:notifications && tsc -p tsconfig.webview.json && npm run build:webview",
    "watch": "tsc -p . --watch",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "local:install": "npm run compile && rm -f opencode-sidekick-*.vsix && npm run package && (code --uninstall-extension kkrenev.opencode-sidekick || true) && rm -rf \"$HOME/.vscode/extensions/kkrenev.opencode-sidekick-\"* && code --install-extension opencode-sidekick-*.vsix --force && code --list-extensions --show-versions | grep opencode-sidekick"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.2"
  }
}
